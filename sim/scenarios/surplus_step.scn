# Surplus steps: the loads come in by priority, and the router keeps the grid at the configured
# export (REQUIRED_EXPORT_IN_WATTS = 20 W) meanwhile. CT2 measures what the loads take.
include common.scn
duration 60

# at <t s> <surplus W>  (W available before the router's loads, > 0 = export)
at 0   -300   # house consumption only
at 15  -300
at 15  1200   # load 1 fully on, load 2 partly
at 35  1200
at 35  2400   # loads 1 and 2 on, load 3 partly
at 50  2400
at 50  -300   # surplus gone: everything off

expect 14 pin 5 off
expect 30 pin 5 on
expect 45 pin 5 on
expect 45 pin 6 on
expect 58 pin 5 off
expect 58 pin 6 off
expect 58 pin 7 off
# Regulation: an ideal router holds the grid at -20 W (REQUIRED_EXPORT_IN_WATTS) on average.
# One mains cycle of a 1 kW load is 20 J, about 1.5 W over these windows: +-10 W leaves room for
# the bucket's level at the window edges and the boards' resolution.
expect 20 35 grid_avg -30 -10
expect 38 50 grid_avg -30 -10
# Diverted energy, as the firmware reports it (CT2): the surplus less the 20 W of export,
# (1200 - 20) W x 20 s + (2400 - 20) W x 15 s = 16.47 Wh, +-5 %: the energy bucket fills up
# (half its 3600 J exported) when the surplus comes, and empties when it goes. The firmware
# counts whole Wh: 15 to 17.
expect diverted_wh 15.65 17.29
# Diverted power, average of the datalog lines printed within the window (every 5 s, the first
# one 6 s after the surplus came): 1180 W +-5 %
expect 22 34 diverted_w_avg 1121 1239
